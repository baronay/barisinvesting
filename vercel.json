{
  "functions": {
    "api/analyze.js":           { "maxDuration": 60 },
    "api/auth.js":              { "maxDuration": 10 },
    "api/bist-ratios.js":       { "maxDuration": 15 },
    "api/tez-admin.js":         { "maxDuration": 10 },
    "api/market.js":            { "maxDuration": 15 },
    "api/garp-bildirim.js":     { "maxDuration": 10 },
    "api/haftalik-secimler.js": { "maxDuration": 10 },
    "api/forum.js":             { "maxDuration": 10 },
    "api/logo.js":              { "maxDuration": 10 },
    "api/watchlist.js":         { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/terminal", "destination": "/index.html" },
    { "source": "/terminal/(.*)", "destination": "/index.html" },
    { "source": "/tezler", "destination": "/index.html" },
    { "source": "/tezler/(.*)", "destination": "/index.html" },
    { "source": "/tez/(.*)", "destination": "/index.html" },
    { "source": "/arastirmalar", "destination": "/index.html" },
    { "source": "/arastirmalar/(.*)", "destination": "/index.html" }
  ]
}
